{
  "pack": "wildfire",
  "tests": [
    {
      "name": "match by color or rank; mismatch is illegal",
      "setup": {
        "seats": 3,
        "turn": {
          "seat": 0,
          "phase": "play"
        },
        "zones": {
          "discard": [
            "red-7"
          ],
          "hand.0": [
            "red-3",
            "green-7",
            "blue-2"
          ]
        },
        "vars": {
          "activeColor": "red"
        }
      },
      "assert": [
        {
          "move": {
            "actor": 0,
            "type": "playCard",
            "cards": [
              "red-3"
            ]
          },
          "legal": true
        },
        {
          "move": {
            "actor": 0,
            "type": "playCard",
            "cards": [
              "green-7"
            ]
          },
          "legal": true
        },
        {
          "move": {
            "actor": 0,
            "type": "playCard",
            "cards": [
              "blue-2"
            ]
          },
          "legal": false,
          "rule": "match"
        }
      ]
    },
    {
      "name": "a wild sets the active color",
      "setup": {
        "seats": 2,
        "turn": {
          "seat": 0,
          "phase": "play"
        },
        "zones": {
          "discard": [
            "red-7"
          ],
          "hand.0": [
            "wild",
            "green-1"
          ],
          "hand.1": [
            "blue-4",
            "red-9"
          ]
        },
        "vars": {
          "activeColor": "red"
        }
      },
      "assert": [
        {
          "apply": {
            "actor": 0,
            "type": "playCard",
            "cards": [
              "wild"
            ],
            "choice": {
              "color": "blue"
            }
          }
        },
        {
          "expect": {
            "vars": {
              "activeColor": "blue"
            },
            "turn": {
              "seat": 1
            }
          }
        },
        {
          "move": {
            "actor": 1,
            "type": "playCard",
            "cards": [
              "blue-4"
            ]
          },
          "legal": true
        },
        {
          "move": {
            "actor": 1,
            "type": "playCard",
            "cards": [
              "red-9"
            ]
          },
          "legal": false,
          "rule": "match"
        }
      ]
    },
    {
      "name": "draw2 makes the next player draw two and lose their turn",
      "setup": {
        "seats": 3,
        "turn": {
          "seat": 0,
          "phase": "play"
        },
        "zones": {
          "discard": [
            "red-5"
          ],
          "hand.0": [
            "red-draw2",
            "green-3"
          ],
          "hand.1": [
            "blue-1",
            "blue-2"
          ],
          "hand.2": [
            "yellow-9"
          ]
        },
        "vars": {
          "activeColor": "red"
        }
      },
      "assert": [
        {
          "apply": {
            "actor": 0,
            "type": "playCard",
            "cards": [
              "red-draw2"
            ]
          }
        },
        {
          "expect": {
            "zones": {
              "hand.1": 4
            },
            "turn": {
              "seat": 2
            }
          }
        }
      ]
    },
    {
      "name": "reverse flips the direction of play",
      "setup": {
        "seats": 3,
        "turn": {
          "seat": 0,
          "phase": "play"
        },
        "direction": "clockwise",
        "zones": {
          "discard": [
            "red-5"
          ],
          "hand.0": [
            "red-reverse",
            "green-3"
          ]
        },
        "vars": {
          "activeColor": "red"
        }
      },
      "assert": [
        {
          "apply": {
            "actor": 0,
            "type": "playCard",
            "cards": [
              "red-reverse"
            ]
          }
        },
        {
          "expect": {
            "direction": "counterclockwise",
            "turn": {
              "seat": 2
            }
          }
        }
      ]
    },
    {
      "name": "reverse acts as a skip with two players",
      "setup": {
        "seats": 2,
        "turn": {
          "seat": 0,
          "phase": "play"
        },
        "zones": {
          "discard": [
            "red-5"
          ],
          "hand.0": [
            "red-reverse",
            "green-3"
          ],
          "hand.1": [
            "blue-1"
          ]
        },
        "vars": {
          "activeColor": "red"
        }
      },
      "assert": [
        {
          "apply": {
            "actor": 0,
            "type": "playCard",
            "cards": [
              "red-reverse"
            ]
          }
        },
        {
          "expect": {
            "turn": {
              "seat": 0
            }
          }
        }
      ]
    },
    {
      "name": "a missed last-card call can be challenged for a two-card penalty",
      "setup": {
        "seats": 2,
        "turn": {
          "seat": 1,
          "phase": "play"
        },
        "zones": {
          "discard": [
            "green-7"
          ],
          "hand.0": [
            "red-2",
            "red-3"
          ],
          "hand.1": [
            "green-3",
            "blue-9"
          ]
        },
        "vars": {
          "activeColor": "green"
        }
      },
      "assert": [
        {
          "apply": {
            "actor": 1,
            "type": "playCard",
            "cards": [
              "green-3"
            ]
          }
        },
        {
          "announce": {
            "actor": 0,
            "challenge": "last-card-call",
            "target": 1
          }
        },
        {
          "expect": {
            "zones": {
              "hand.1": 3
            }
          }
        }
      ]
    },
    {
      "name": "a made last-card call cannot be successfully challenged",
      "setup": {
        "seats": 2,
        "turn": {
          "seat": 1,
          "phase": "play"
        },
        "zones": {
          "discard": [
            "green-7"
          ],
          "hand.0": [
            "red-2",
            "red-3"
          ],
          "hand.1": [
            "green-3",
            "blue-9"
          ]
        },
        "vars": {
          "activeColor": "green"
        }
      },
      "assert": [
        {
          "announce": {
            "actor": 1,
            "id": "last-card-call"
          }
        },
        {
          "apply": {
            "actor": 1,
            "type": "playCard",
            "cards": [
              "green-3"
            ]
          }
        },
        {
          "announce": {
            "actor": 0,
            "challenge": "last-card-call",
            "target": 1
          }
        },
        {
          "expect": {
            "zones": {
              "hand.1": 1
            }
          }
        }
      ]
    },
    {
      "name": "round scoring sends leftover hand values to the winner",
      "setup": {
        "seats": 3,
        "zones": {
          "hand.0": [],
          "hand.1": [
            "wild",
            "red-draw2"
          ],
          "hand.2": [
            "blue-3"
          ]
        }
      },
      "assert": [
        {
          "score": {
            "0": 73,
            "1": 0,
            "2": 0
          }
        }
      ]
    },
    {
      "name": "a declaration is a logged move, so it survives a replay",
      "setup": {
        "seats": 2,
        "turn": {
          "seat": 1,
          "phase": "play"
        },
        "zones": {
          "discard": [
            "green-7"
          ],
          "hand.0": [
            "red-2",
            "red-3"
          ],
          "hand.1": [
            "green-3",
            "blue-9"
          ]
        },
        "vars": {
          "activeColor": "green"
        }
      },
      "assert": [
        {
          "apply": {
            "actor": 1,
            "type": "playCard",
            "cards": [
              "green-3"
            ]
          }
        },
        {
          "apply": {
            "actor": 1,
            "type": "announce",
            "id": "last-card-call"
          }
        },
        {
          "move": {
            "actor": 0,
            "type": "challenge",
            "id": "last-card-call",
            "target": 1
          },
          "legal": false,
          "rule": "not-catchable"
        },
        {
          "expect": {
            "zones": {
              "hand.1": 1
            }
          }
        }
      ]
    },
    {
      "name": "catching a silent player is legal out of turn and costs them the penalty",
      "setup": {
        "seats": 2,
        "turn": {
          "seat": 1,
          "phase": "play"
        },
        "zones": {
          "discard": [
            "green-7"
          ],
          "hand.0": [
            "red-2",
            "red-3"
          ],
          "hand.1": [
            "green-3",
            "blue-9"
          ]
        },
        "vars": {
          "activeColor": "green"
        }
      },
      "assert": [
        {
          "apply": {
            "actor": 1,
            "type": "playCard",
            "cards": [
              "green-3"
            ]
          }
        },
        {
          "move": {
            "actor": 0,
            "type": "challenge",
            "id": "last-card-call",
            "target": 1
          },
          "legal": true
        },
        {
          "apply": {
            "actor": 0,
            "type": "challenge",
            "id": "last-card-call",
            "target": 1
          }
        },
        {
          "expect": {
            "zones": {
              "hand.1": 3
            },
            "turn": {
              "seat": 0
            }
          }
        }
      ]
    },
    {
      "name": "nobody may be caught twice for the same silence",
      "setup": {
        "seats": 2,
        "turn": {
          "seat": 1,
          "phase": "play"
        },
        "zones": {
          "discard": [
            "green-7"
          ],
          "hand.0": [
            "red-2",
            "red-3"
          ],
          "hand.1": [
            "green-3",
            "blue-9"
          ]
        },
        "vars": {
          "activeColor": "green"
        }
      },
      "assert": [
        {
          "apply": {
            "actor": 1,
            "type": "playCard",
            "cards": [
              "green-3"
            ]
          }
        },
        {
          "apply": {
            "actor": 0,
            "type": "challenge",
            "id": "last-card-call",
            "target": 1
          }
        },
        {
          "move": {
            "actor": 0,
            "type": "challenge",
            "id": "last-card-call",
            "target": 1
          },
          "legal": false,
          "rule": "not-catchable"
        },
        {
          "expect": {
            "zones": {
              "hand.1": 3
            }
          }
        }
      ]
    },
    {
      "name": "a declaration lapses once the hand grows back out of range",
      "setup": {
        "seats": 2,
        "turn": {
          "seat": 1,
          "phase": "play"
        },
        "zones": {
          "discard": [
            "green-7"
          ],
          "hand.0": [
            "red-2",
            "red-3"
          ],
          "hand.1": [
            "green-3",
            "blue-9"
          ]
        },
        "vars": {
          "activeColor": "green"
        }
      },
      "assert": [
        {
          "apply": {
            "actor": 1,
            "type": "announce",
            "id": "last-card-call"
          }
        },
        {
          "expect": {
            "playerVars": {
              "1": {
                "__last-card-callCalled": true
              }
            }
          }
        },
        {
          "apply": {
            "actor": 1,
            "type": "draw"
          }
        },
        {
          "expect": {
            "playerVars": {
              "1": {
                "__last-card-callCalled": false
              }
            }
          }
        }
      ]
    },
    {
      "name": "you cannot declare with a hand nowhere near the count",
      "setup": {
        "seats": 2,
        "turn": {
          "seat": 1,
          "phase": "play"
        },
        "zones": {
          "discard": [
            "green-7"
          ],
          "hand.0": [
            "red-2",
            "red-3",
            "red-4",
            "blue-5"
          ],
          "hand.1": [
            "green-3",
            "blue-9"
          ]
        },
        "vars": {
          "activeColor": "green"
        }
      },
      "assert": [
        {
          "move": {
            "actor": 0,
            "type": "announce",
            "id": "last-card-call"
          },
          "legal": false,
          "rule": "not-at-count"
        },
        {
          "move": {
            "actor": 1,
            "type": "announce",
            "id": "last-card-call"
          },
          "legal": true
        },
        {
          "move": {
            "actor": 1,
            "type": "challenge",
            "id": "last-card-call",
            "target": 0
          },
          "legal": false,
          "rule": "not-catchable"
        },
        {
          "move": {
            "actor": 1,
            "type": "challenge",
            "id": "last-card-call",
            "target": 1
          },
          "legal": false,
          "rule": "self-challenge"
        }
      ]
    },
    {
      "name": "a second descent to the last card needs declaring again",
      "setup": {
        "seats": 2,
        "turn": {
          "seat": 1,
          "phase": "play"
        },
        "zones": {
          "discard": [
            "green-7"
          ],
          "hand.0": [
            "green-2",
            "green-5",
            "green-6"
          ],
          "hand.1": [
            "green-3",
            "wild"
          ]
        },
        "vars": {
          "activeColor": "green"
        }
      },
      "assert": [
        {
          "apply": {
            "actor": 1,
            "type": "announce",
            "id": "last-card-call"
          }
        },
        {
          "apply": {
            "actor": 1,
            "type": "playCard",
            "cards": [
              "green-3"
            ]
          }
        },
        {
          "expect": {
            "playerVars": {
              "1": {
                "__last-card-callCalled": true
              }
            },
            "zones": {
              "hand.1": 1
            }
          }
        },
        {
          "move": {
            "actor": 0,
            "type": "challenge",
            "id": "last-card-call",
            "target": 1
          },
          "legal": false,
          "rule": "not-catchable"
        },
        {
          "apply": {
            "actor": 0,
            "type": "playCard",
            "cards": [
              "green-2"
            ]
          }
        },
        {
          "apply": {
            "actor": 1,
            "type": "draw"
          }
        },
        {
          "expect": {
            "playerVars": {
              "1": {
                "__last-card-callCalled": false
              }
            },
            "zones": {
              "hand.1": 2
            }
          }
        },
        {
          "apply": {
            "actor": 0,
            "type": "playCard",
            "cards": [
              "green-5"
            ]
          }
        },
        {
          "apply": {
            "actor": 1,
            "type": "playCard",
            "cards": [
              "wild"
            ],
            "choice": {
              "color": "green"
            }
          }
        },
        {
          "expect": {
            "zones": {
              "hand.1": 1
            }
          }
        },
        {
          "move": {
            "actor": 1,
            "type": "announce",
            "id": "last-card-call"
          },
          "legal": true
        },
        {
          "move": {
            "actor": 0,
            "type": "challenge",
            "id": "last-card-call",
            "target": 1
          },
          "legal": true
        }
      ]
    }
  ]
}
