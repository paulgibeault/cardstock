    {
      "name": "a declaration lapses once the hand grows back out of range",
      "setup": {
        "seats": 2,
        "turn": {
          "seat": 1,
          "phase": "play"
        },
        "zones": {
          "discard": [
            "green-7"
          ],
          "hand.0": [
            "red-2",
            "red-3"
          ],
          "hand.1": [
            "green-3",
            "blue-9"
          ],
          "draw": [
            "blue-1"
          ]
        },
        "vars": {
          "activeColor": "green"
        }
      },
      "assert": [
        {
          "apply": {
            "actor": 1,
            "type": "announce",
            "id": "last-card-call"
          }
        },
        {
          "expect": {
            "playerVars": {
              "1": {
                "__last-card-callCalled": true
              }
            }
          }
