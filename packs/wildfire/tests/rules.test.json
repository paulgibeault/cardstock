    {
      "name": "a missed last-card call can be challenged for a two-card penalty",
      "setup": {
        "seats": 2,
        "turn": {
          "seat": 1,
          "phase": "play"
        },
        "zones": {
          "discard": [
            "green-7"
          ],
          "hand.0": [
            "red-2",
            "red-3"
          ],
          "hand.1": [
            "green-3",
            "blue-9"
          ]
        },
        "vars": {
          "activeColor": "green"
        }
      },
      "assert": [
        {
          "apply": {
            "actor": 1,
            "type": "playCard",
            "cards": [
              "green-3"
            ]
          }
        },
        {
          "announce": {
            "actor": 0,
            "challenge": "last-card-call",
            "target": 1
          }
        },
        {
          "expect": {
            "zones": {
              "hand.1": 3
            }
          }
        }
      ]
    },
    {
      "name": "a made last-card call cannot be successfully challenged",
      "setup": {
        "seats": 2,
        "turn": {
          "seat": 1,
          "phase": "play"
        },
        "zones": {
          "discard": [
            "green-7"
          ],
          "hand.0": [
            "red-2",
            "red-3"
          ],
          "hand.1": [
            "green-3",
            "blue-9"
          ]
        },
        "vars": {
          "activeColor": "green"
        }
      },
      "assert": [
        {
          "announce": {
            "actor": 1,
            "id": "last-card-call"
          }
        },
        {
          "apply": {
            "actor": 1,
            "type": "playCard",
            "cards": [
              "green-3"
            ]
          }
        },
        {
          "announce": {
            "actor": 0,
            "challenge": "last-card-call",
            "target": 1
          }
        },
        {
          "expect": {
            "zones": {
              "hand.1": 1
            }
          }
        }
      ]
    },
    {
      "name": "round scoring sends leftover hand values to the winner",
      "setup": {
        "seats": 3,
        "zones": {
          "hand.0": [],
          "hand.1": [
            "wild",
            "red-draw2"
          ],
          "hand.2": [
            "blue-3"
          ]
        }
      },
      "assert": [
        {
          "score": {
            "0": 73,
            "1": 0,
            "2": 0
          }
        }
      ]
    },
    {
      "name": "a declaration is a logged move, so it survives a replay",
      "setup": {
        "seats": 2,
        "turn": {
          "seat": 1,
          "phase": "play"
        },
        "zones": {
          "discard": [
            "green-7"
          ],
          "hand.0": [
            "red-2",
            "red-3"
          ],
          "hand.1": [
            "green-3",
            "blue-9"
          ]
        },
        "vars": {
          "activeColor": "green"
        }
      },
      "assert": [
        {
          "apply": {
            "actor": 1,
            "type": "playCard",
            "cards": [
              "green-3"
            ]
          }
        },
        {
          "apply": {
            "actor": 1,
            "type": "announce",
            "id": "last-card-call"
          }
        },
        {
          "move": {
            "actor": 0,
            "type": "challenge",
            "id": "last-card-call",
            "target": 1
          },
          "legal": false,
          "rule": "not-catchable"
        },
        {
          "expect": {
            "zones": {
              "hand.1": 1
            }
          }
        }
      ]
    },
