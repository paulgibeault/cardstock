      ]
    },
    {
      "name": "two-handed: nothing but taking a hand is a move while the hands are on offer",
      "setup": {
        "seats": 2,
        "turn": { "seat": 1, "phase": "choose" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": [],
          "hand.1": [],
          "offer.1": ["spades-5", "hearts-9"],
          "offer.2": ["clubs-4", "diamonds-K"],
          "offer.3": ["spades-7", "hearts-2"]
        },
        "vars": { "combo": null, "passed": [], "lastPlayer": null, "leader": 0, "trickNumber": 1, "opening": null }
      },
      "assert": [
        { "move": { "actor": 0, "type": "takeHand", "from": "offer.1" },
          "legal": false, "rule": "turn" },
        { "move": { "actor": 1, "type": "playCard", "cards": ["clubs-4"] },
          "legal": false, "rule": "choosing" },
        { "move": { "actor": 1, "type": "pass" },
          "legal": false, "rule": "choosing" },
        { "move": { "actor": 1, "type": "takeHand", "from": "pile" },
          "legal": false, "rule": "not-on-offer" },
        { "apply": { "actor": 1, "type": "takeHand", "from": "offer.2" } },
        { "expect": { "turn": { "seat": 0, "phase": "choose" },
          "zones": { "hand.1": ["clubs-4", "diamonds-K"], "offer.2": 0 } } },
        { "move": { "actor": 0, "type": "takeHand", "from": "offer.2" },
          "legal": false, "rule": "not-on-offer" }
      ]
    },
    {
      "name": "two-handed: the hand nobody took leaves the table, and the lowest card in play leads",
