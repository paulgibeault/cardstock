{
  "pack": "thirteen",
  "tests": [
    {
      "name": "K-A-2 is not a run; Q-K-A is",
      "setup": {
        "seats": 4,
        "turn": { "seat": 0, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["spades-Q", "spades-K", "spades-A", "spades-2"],
          "hand.1": ["diamonds-4"],
          "hand.2": ["diamonds-5"],
          "hand.3": ["diamonds-6"]
        },
        "vars": { "combo": null, "passed": [], "lastPlayer": null, "leader": 0, "trickNumber": 1 }
      },
      "assert": [
        { "move": { "actor": 0, "type": "playCard", "cards": ["spades-K", "spades-A", "spades-2"] },
          "legal": false, "rule": "not-a-combination" },
        { "move": { "actor": 0, "type": "playCard", "cards": ["spades-Q", "spades-K", "spades-A"] },
          "legal": true }
      ]
    },
    {
      "name": "a four-card run is not a legal answer to a three-card run",
      "setup": {
        "seats": 4,
        "turn": { "seat": 0, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["clubs-5", "clubs-6", "clubs-7", "spades-4"],
          "hand.1": ["diamonds-4"],
          "hand.2": ["diamonds-9"],
          "hand.3": ["hearts-5", "hearts-6", "hearts-7", "hearts-8", "spades-9"]
        },
        "vars": { "combo": null, "passed": [], "lastPlayer": null, "leader": 0, "trickNumber": 1 }
      },
      "assert": [
        { "apply": { "actor": 0, "type": "playCard", "cards": ["clubs-5", "clubs-6", "clubs-7"] } },
        { "expect": { "turn": { "seat": 3 } } },
        { "move": { "actor": 3, "type": "playCard", "cards": ["hearts-5", "hearts-6", "hearts-7", "hearts-8"] },
          "legal": false, "rule": "wrong-shape" },
        { "move": { "actor": 3, "type": "playCard", "cards": ["hearts-6", "hearts-7", "hearts-8"] },
          "legal": true }
      ]
    },
    {
      "name": "9H 9D beats 9C 9S — the suit ladder breaks the tie",
      "setup": {
        "seats": 4,
        "turn": { "seat": 0, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["clubs-9", "spades-9", "diamonds-3"],
          "hand.1": ["diamonds-4"],
          "hand.2": ["diamonds-5"],
          "hand.3": ["hearts-9", "diamonds-9", "spades-4"]
        },
        "vars": { "combo": null, "passed": [], "lastPlayer": null, "leader": 0, "trickNumber": 1 }
      },
      "assert": [
        { "apply": { "actor": 0, "type": "playCard", "cards": ["clubs-9", "spades-9"] } },
        { "move": { "actor": 3, "type": "playCard", "cards": ["hearts-9", "diamonds-9"] }, "legal": true }
      ]
    },
    {
      "name": "9C 9S does not beat 9H 9D — and not the reverse",
      "setup": {
        "seats": 4,
        "turn": { "seat": 0, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["hearts-9", "diamonds-9", "diamonds-3"],
          "hand.1": ["diamonds-4"],
          "hand.2": ["diamonds-5"],
          "hand.3": ["clubs-9", "spades-9", "spades-4"]
        },
        "vars": { "combo": null, "passed": [], "lastPlayer": null, "leader": 0, "trickNumber": 1 }
      },
      "assert": [
        { "apply": { "actor": 0, "type": "playCard", "cards": ["hearts-9", "diamonds-9"] } },
        { "move": { "actor": 3, "type": "playCard", "cards": ["clubs-9", "spades-9"] },
          "legal": false, "rule": "not-higher" }
      ]
    },
    {
      "name": "three consecutive pairs chop a lone 2 and do not chop a pair of 2s",
      "setup": {
        "seats": 4,
        "turn": { "seat": 0, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["hearts-2", "spades-2", "clubs-2", "diamonds-4"],
          "hand.1": ["diamonds-5"],
          "hand.2": ["diamonds-6"],
          "hand.3": ["spades-5", "clubs-5", "spades-6", "clubs-6", "spades-7", "clubs-7", "diamonds-9"]
        },
        "vars": { "combo": null, "passed": [], "lastPlayer": null, "leader": 0, "trickNumber": 1 }
      },
      "assert": [
        { "apply": { "actor": 0, "type": "playCard", "cards": ["hearts-2"] } },
        { "move": { "actor": 3, "type": "playCard",
                    "cards": ["spades-5", "clubs-5", "spades-6", "clubs-6", "spades-7", "clubs-7"] },
          "legal": true },
        { "apply": { "actor": 3, "type": "pass" } },
        { "apply": { "actor": 2, "type": "pass" } },
        { "apply": { "actor": 1, "type": "pass" } },
        { "expect": { "turn": { "seat": 0 }, "vars": { "combo": null, "passed": [], "leader": 0 } } },
        { "apply": { "actor": 0, "type": "playCard", "cards": ["spades-2", "clubs-2"] } },
        { "move": { "actor": 3, "type": "playCard",
                    "cards": ["spades-5", "clubs-5", "spades-6", "clubs-6", "spades-7", "clubs-7"] },
          "legal": false, "rule": "wrong-shape" }
      ]
    },
    {
      "name": "a bomb chops only what its list names — a lone ace is not a pig",
      "setup": {
        "seats": 4,
        "turn": { "seat": 0, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["hearts-A", "hearts-2", "diamonds-4"],
          "hand.1": ["diamonds-J"],
          "hand.2": ["diamonds-10"],
          "hand.3": ["spades-5", "clubs-5", "spades-6", "clubs-6", "spades-7", "clubs-7", "diamonds-9"]
        },
        "vars": { "combo": null, "passed": [], "lastPlayer": null, "leader": 0, "trickNumber": 1 }
      },
      "assert": [
        { "apply": { "actor": 0, "type": "playCard", "cards": ["hearts-A"] } },
        { "move": { "actor": 3, "type": "playCard",
                    "cards": ["spades-5", "clubs-5", "spades-6", "clubs-6", "spades-7", "clubs-7"] },
          "legal": false, "rule": "wrong-shape" },
        { "apply": { "actor": 3, "type": "pass" } },
        { "apply": { "actor": 2, "type": "pass" } },
        { "apply": { "actor": 1, "type": "pass" } },
        { "apply": { "actor": 0, "type": "playCard", "cards": ["hearts-2"] } },
        { "move": { "actor": 3, "type": "playCard",
                    "cards": ["spades-5", "clubs-5", "spades-6", "clubs-6", "spades-7", "clubs-7"] },
          "legal": true }
      ]
    },
    {
      "name": "four of a kind chops the three consecutive pairs that just chopped a pig",
      "setup": {
        "seats": 4,
        "turn": { "seat": 0, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["hearts-2", "diamonds-4"],
          "hand.1": ["diamonds-J"],
          "hand.2": ["spades-8", "clubs-8", "diamonds-8", "hearts-8", "diamonds-10"],
          "hand.3": ["spades-5", "clubs-5", "spades-6", "clubs-6", "spades-7", "clubs-7", "diamonds-9"]
        },
        "vars": { "combo": null, "passed": [], "lastPlayer": null, "leader": 0, "trickNumber": 1 }
      },
      "assert": [
        { "apply": { "actor": 0, "type": "playCard", "cards": ["hearts-2"] } },
        { "apply": { "actor": 3, "type": "playCard",
                     "cards": ["spades-5", "clubs-5", "spades-6", "clubs-6", "spades-7", "clubs-7"] } },
        { "expect": { "turn": { "seat": 2 } } },
        { "move": { "actor": 2, "type": "playCard",
                    "cards": ["spades-8", "clubs-8", "diamonds-8", "hearts-8"] },
          "legal": true }
      ]
    },
    {
      "name": "a seat that passed is out of the trick, whatever it is holding",
      "variants": [],
      "setup": {
        "seats": 4,
        "turn": { "seat": 3, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["diamonds-4"],
          "hand.1": ["diamonds-5"],
          "hand.2": ["diamonds-6"],
          "hand.3": ["hearts-2"],
          "pile": ["spades-4"]
        },
        "vars": {
          "combo": { "kind": "single", "size": 1, "top": 4, "cards": ["spades-4"], "seat": 0 },
          "passed": [3], "lastPlayer": 0, "leader": 0, "trickNumber": 1
        }
      },
      "assert": [
        { "move": { "actor": 3, "type": "playCard", "cards": ["hearts-2"] },
          "legal": false, "rule": "passed" },
        { "move": { "actor": 3, "type": "pass" }, "legal": false, "rule": "passed" }
      ]
    },
    {
      "name": "pass-stays-in: the same passed seat is asked again, and may play or pass",
      "variants": ["pass-stays-in"],
      "setup": {
        "seats": 4,
        "turn": { "seat": 3, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["diamonds-4"],
          "hand.1": ["diamonds-5"],
          "hand.2": ["diamonds-6"],
          "hand.3": ["hearts-2"],
          "pile": ["spades-4"]
        },
        "vars": {
          "combo": { "kind": "single", "size": 1, "top": 4, "cards": ["spades-4"], "seat": 0 },
          "passed": [3], "lastPlayer": 0, "leader": 0, "trickNumber": 1
        }
      },
      "assert": [
        { "move": { "actor": 3, "type": "playCard", "cards": ["hearts-2"] }, "legal": true },
        { "move": { "actor": 3, "type": "pass" }, "legal": true }
      ]
    },
    {
      "name": "two-tops-runs: K-A-2 is a run, and it still does not wrap to A-2-3",
      "variants": ["two-tops-runs"],
      "setup": {
        "seats": 4,
        "turn": { "seat": 0, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["spades-K", "spades-A", "spades-2", "spades-3", "clubs-4"],
          "hand.1": ["diamonds-4"],
          "hand.2": ["diamonds-5"],
          "hand.3": ["diamonds-6"]
        },
        "vars": { "combo": null, "passed": [], "lastPlayer": null, "leader": 0, "trickNumber": 1 }
      },
      "assert": [
        { "move": { "actor": 0, "type": "playCard", "cards": ["spades-K", "spades-A", "spades-2"] },
          "legal": true },
        { "move": { "actor": 0, "type": "playCard", "cards": ["spades-A", "spades-2", "spades-3"] },
          "legal": false, "rule": "not-a-combination" }
      ]
    },
    {
      "name": "two-tops-runs: a 2 is still no part of consecutive pairs",
      "variants": ["two-tops-runs"],
      "setup": {
        "seats": 4,
        "turn": { "seat": 0, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["spades-2", "clubs-2", "spades-A", "clubs-A", "spades-K", "clubs-K",
                     "spades-Q", "clubs-Q"],
          "hand.1": ["diamonds-4"],
          "hand.2": ["diamonds-5"],
          "hand.3": ["diamonds-6"]
        },
        "vars": { "combo": null, "passed": [], "lastPlayer": null, "leader": 0, "trickNumber": 1 }
      },
      "assert": [
        { "move": { "actor": 0, "type": "playCard",
                    "cards": ["spades-2", "clubs-2", "spades-A", "clubs-A", "spades-K", "clubs-K"] },
          "legal": false, "rule": "not-a-combination" },
        { "move": { "actor": 0, "type": "playCard",
                    "cards": ["spades-A", "clubs-A", "spades-K", "clubs-K", "spades-Q", "clubs-Q"] },
          "legal": true }
      ]
    },
    {
      "name": "the opening lead is refused unless it contains the lowest card in play, 3 of spades or not",
      "setup": {
        "seats": 3,
        "turn": { "seat": 2, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["diamonds-4"],
          "hand.1": ["diamonds-5"],
          "hand.2": ["clubs-3", "hearts-3", "spades-7"]
        },
        "vars": { "combo": null, "passed": [], "lastPlayer": null, "leader": 2, "trickNumber": 1 },
        "playerVars": { "2": { "__mustInclude": "clubs-3" } }
      },
      "assert": [
        { "move": { "actor": 2, "type": "playCard", "cards": ["spades-7"] },
          "legal": false, "rule": "first-lead" },
        { "move": { "actor": 2, "type": "playCard", "cards": ["hearts-3"] },
          "legal": false, "rule": "first-lead" },
        { "move": { "actor": 2, "type": "playCard", "cards": ["clubs-3"] }, "legal": true },
        { "move": { "actor": 2, "type": "playCard", "cards": ["clubs-3", "hearts-3"] }, "legal": true }
      ]
    },
    {
      "name": "the first lead of hand one is refused unless it contains the 3 of spades",
      "setup": {
        "seats": 4,
        "turn": { "seat": 0, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["spades-3", "clubs-3", "spades-7"],
          "hand.1": ["diamonds-4"],
          "hand.2": ["diamonds-5"],
          "hand.3": ["diamonds-6"]
        },
        "vars": { "combo": null, "passed": [], "lastPlayer": null, "leader": 0, "trickNumber": 1 },
        "playerVars": { "0": { "__mustInclude": "spades-3" } }
      },
      "assert": [
        { "move": { "actor": 0, "type": "playCard", "cards": ["spades-7"] },
          "legal": false, "rule": "first-lead" },
        { "move": { "actor": 0, "type": "playCard", "cards": ["spades-3"] }, "legal": true },
        { "move": { "actor": 0, "type": "playCard", "cards": ["spades-3", "clubs-3"] }, "legal": true }
      ]
    },
    {
      "name": "a trick clears and the last player to have played leads next",
      "setup": {
        "seats": 4,
        "turn": { "seat": 0, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["spades-4", "diamonds-5"],
          "hand.1": ["diamonds-6"],
          "hand.2": ["diamonds-7"],
          "hand.3": ["hearts-9", "clubs-J"]
        },
        "vars": { "combo": null, "passed": [], "lastPlayer": null, "leader": 0, "trickNumber": 1 }
      },
      "assert": [
        { "apply": { "actor": 0, "type": "playCard", "cards": ["spades-4"] } },
        { "apply": { "actor": 3, "type": "playCard", "cards": ["hearts-9"] } },
        { "apply": { "actor": 2, "type": "pass" } },
        { "apply": { "actor": 1, "type": "pass" } },
        { "apply": { "actor": 0, "type": "pass" } },
        { "expect": {
            "turn": { "seat": 3 },
            "vars": { "combo": null, "passed": [], "leader": 3, "lastPlayer": null, "trickNumber": 2 },
            "zones": { "pile": 0, "discard": 2 }
          } }
      ]
    },
    {
      "name": "four of a kind chops a pair of 2s — the default (D-6)",
      "setup": {
        "seats": 4,
        "turn": { "seat": 2, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["diamonds-4"],
          "hand.1": ["diamonds-J"],
          "hand.2": ["spades-8", "clubs-8", "diamonds-8", "hearts-8", "diamonds-10"],
          "hand.3": ["spades-5", "clubs-5", "spades-6", "clubs-6", "spades-7", "clubs-7", "diamonds-9"],
          "pile": ["spades-2", "clubs-2"]
        },
        "vars": {
          "combo": { "kind": "pair", "size": 2, "top": 49, "cards": ["spades-2", "clubs-2"], "seat": 0 },
          "passed": [], "lastPlayer": 0, "leader": 0, "trickNumber": 1
        }
      },
      "assert": [
        { "move": { "actor": 2, "type": "playCard",
                    "cards": ["spades-8", "clubs-8", "diamonds-8", "hearts-8"] },
          "legal": true }
      ]
    },
    {
      "name": "quad-needs-four-pairs: the quad no longer chops a pair of 2s, four consecutive pairs still do",
      "variants": ["quad-needs-four-pairs"],
      "setup": {
        "seats": 4,
        "turn": { "seat": 3, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["diamonds-4"],
          "hand.1": ["diamonds-J"],
          "hand.2": ["spades-8", "clubs-8", "diamonds-8", "hearts-8", "diamonds-10"],
          "hand.3": ["spades-4", "clubs-4", "spades-5", "clubs-5", "spades-6", "clubs-6",
                     "spades-7", "clubs-7", "diamonds-9"],
          "pile": ["spades-2", "clubs-2"]
        },
        "vars": {
          "combo": { "kind": "pair", "size": 2, "top": 49, "cards": ["spades-2", "clubs-2"], "seat": 0 },
          "passed": [], "lastPlayer": 0, "leader": 0, "trickNumber": 1
        }
      },
      "assert": [
        { "move": { "actor": 3, "type": "playCard",
                    "cards": ["spades-4", "clubs-4", "spades-5", "clubs-5",
                              "spades-6", "clubs-6", "spades-7", "clubs-7"] },
          "legal": true },
        { "apply": { "actor": 3, "type": "pass" } },
        { "expect": { "turn": { "seat": 2 } } },
        { "move": { "actor": 2, "type": "playCard",
                    "cards": ["spades-8", "clubs-8", "diamonds-8", "hearts-8"] },
          "legal": false, "rule": "wrong-shape" }
      ]
    },
    {
      "name": "no-ending-on-two: a 2 may not be your last card",
      "variants": ["no-ending-on-two"],
      "setup": {
        "seats": 4,
        "turn": { "seat": 3, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["diamonds-9"],
          "hand.1": ["diamonds-5"],
          "hand.2": ["diamonds-6"],
          "hand.3": ["hearts-2"],
          "pile": ["clubs-4"]
        },
        "vars": {
          "combo": { "kind": "single", "size": 1, "top": 5, "cards": ["clubs-4"], "seat": 0 },
          "passed": [], "lastPlayer": 0, "leader": 0, "trickNumber": 1
        }
      },
      "assert": [
        { "move": { "actor": 3, "type": "playCard", "cards": ["hearts-2"] },
          "legal": false, "rule": "last-card" },
        { "move": { "actor": 3, "type": "pass" }, "legal": true }
      ]
    },
    {
      "name": "the same 2 is a fine way to go out with the house rule off",
      "setup": {
        "seats": 4,
        "turn": { "seat": 3, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["diamonds-9"],
          "hand.1": ["diamonds-5"],
          "hand.2": ["diamonds-6"],
          "hand.3": ["hearts-2"],
          "pile": ["clubs-4"]
        },
        "vars": {
          "combo": { "kind": "single", "size": 1, "top": 5, "cards": ["clubs-4"], "seat": 0 },
          "passed": [], "lastPlayer": 0, "leader": 0, "trickNumber": 1
        }
      },
      "assert": [
        { "move": { "actor": 3, "type": "playCard", "cards": ["hearts-2"] }, "legal": true }
      ]
    },
    {
      "name": "no-ending-on-two: the 2 you are not going out on is still a play",
      "variants": ["no-ending-on-two"],
      "setup": {
        "seats": 4,
        "turn": { "seat": 3, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["diamonds-9"],
          "hand.1": ["diamonds-5"],
          "hand.2": ["diamonds-6"],
          "hand.3": ["hearts-2", "spades-7"],
          "pile": ["clubs-4"]
        },
        "vars": {
          "combo": { "kind": "single", "size": 1, "top": 5, "cards": ["clubs-4"], "seat": 0 },
          "passed": [], "lastPlayer": 0, "leader": 0, "trickNumber": 1
        }
      },
      "assert": [
        { "move": { "actor": 3, "type": "playCard", "cards": ["hearts-2"] }, "legal": true }
      ]
    },
    {
      "name": "no-ending-on-two: the rule relaxes rather than stalling a leader holding nothing else",
      "variants": ["no-ending-on-two"],
      "setup": {
        "seats": 4,
        "turn": { "seat": 3, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["diamonds-9"],
          "hand.1": ["diamonds-5"],
          "hand.2": ["diamonds-6"],
          "hand.3": ["hearts-2"]
        },
        "vars": { "combo": null, "passed": [], "lastPlayer": null, "leader": 3, "trickNumber": 1 }
      },
      "assert": [
        { "move": { "actor": 3, "type": "pass" }, "legal": false, "rule": "must-lead" },
        { "move": { "actor": 3, "type": "playCard", "cards": ["hearts-2"] }, "legal": true }
      ]
    },
    {
      "name": "instant-wins: the whole hand goes down, and everybody else pays for all thirteen",
      "variants": ["instant-wins"],
      "setup": {
        "seats": 4,
        "turn": { "seat": 0, "phase": "play" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": ["spades-2", "clubs-2", "diamonds-2", "hearts-2", "spades-3", "clubs-4",
                     "diamonds-5", "hearts-6", "spades-7", "clubs-8", "diamonds-9",
                     "hearts-10", "spades-J"],
          "hand.1": ["diamonds-J"],
          "hand.2": ["diamonds-Q", "hearts-Q"],
          "hand.3": ["diamonds-K", "hearts-K", "spades-K"]
        },
        "vars": {
          "combo": null, "passed": [], "lastPlayer": null, "leader": 0, "trickNumber": 1,
          "instantWin": { "seat": 0, "shape": "four pigs" }
        }
      },
      "assert": [
        { "move": { "actor": 0, "type": "playCard", "cards": ["spades-3"] },
          "legal": false, "rule": "instant-win" },
        { "move": { "actor": 0, "type": "playCard",
                    "cards": ["spades-2", "clubs-2", "diamonds-2", "hearts-2"] },
          "legal": false, "rule": "instant-win" },
        { "move": { "actor": 1, "type": "playCard", "cards": ["diamonds-J"] },
          "legal": false, "rule": "turn" },
        { "apply": { "actor": 0, "type": "playCard",
                     "cards": ["spades-2", "clubs-2", "diamonds-2", "hearts-2", "spades-3", "clubs-4",
                               "diamonds-5", "hearts-6", "spades-7", "clubs-8", "diamonds-9",
                               "hearts-10", "spades-J"] } },
        { "expect": { "scores": { "0": 0, "1": 1, "2": 2, "3": 3 } } }
      ]
    },
    {
      "name": "the cards left in your hand are the points, and going out costs nothing",
