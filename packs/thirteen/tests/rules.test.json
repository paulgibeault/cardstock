          "playerVars": { "1": { "__mustInclude": "clubs-4" } } } },
        { "move": { "actor": 1, "type": "playCard", "cards": ["diamonds-K"] },
          "legal": false, "rule": "first-lead" },
        { "move": { "actor": 1, "type": "playCard", "cards": ["clubs-4"] }, "legal": true }
