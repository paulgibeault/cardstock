        "seats": 2,
        "turn": { "seat": 1, "phase": "choose" },
        "direction": "counterclockwise",
        "zones": {
          "hand.0": [],
          "hand.1": [],
          "offer.1": ["spades-5", "hearts-9"],
          "offer.2": ["clubs-4", "diamonds-K"],
          "offer.3": ["spades-7", "hearts-2"]
