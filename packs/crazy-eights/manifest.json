{
  "id": "crazy-eights",
  "name": "Crazy Eights",
  "version": "0.1.0",
  "players": { "min": 2, "max": 5, "best": 4 },
  "deck": "standard-52",
  "template": "shedding",
  "tagline": "Empty your hand. Eights are wild.",
  "howToPlay": [
    "The eights are the whole game. They can be played on anything and they change the suit, so the question is never whether to play one but when — an eight spent to escape a bad suit is an eight you no longer have when somebody else picks the suit you cannot follow."
  ],
  "accent": "#2f6fb0",
  "heroCards": [
    { "rank": "8", "suit": "spades", "effect": { "type": "wild", "choose": "suit" } },
    { "rank": "8", "suit": "hearts", "effect": { "type": "wild", "choose": "suit" } },
    { "rank": "K", "suit": "diamonds" }
  ],
  "rules": {
    "matchOn": ["suit", "rank"],
    "deal": { "default": 5, "byPlayers": { "2": 7 } },
    "effects": {
      "rank:8": { "type": "wild", "choose": "suit" }
    },
    "drawWhenStuck": 1,
    "playAfterDraw": true,
    "mustPlayIfAble": false,
    "winner": "first-empty-hand"
  },
  "scoring": {
    "defaultValue": "faceValue",
    "cardValues": { "rank:8": 50, "rank:J": 10, "rank:Q": 10, "rank:K": 10, "rank:A": 1 },
    "roundScore": "hand-values-to-winner",
    "accumulate": true,
    "gameOver": { "when": "anyScore >= 100", "winner": "highestScore" }
  },
  "variants": [
    {
      "id": "draw-until-playable",
      "name": "Draw until playable",
      "description": "Instead of drawing one card when stuck, draw until you can play.",
      "default": false,
      "patch": { "rules.drawWhenStuck": "until-playable" }
    }
  ],
  "undo": "none",
  "turnTimer": null,
  "ui": {
    "cardBack": { "pattern": "pinstripe", "color": "#2f6fb0", "emblem": "8" }
  },
  "credits": "Traditional (public domain)."
}
