{
  "id": "milestones",
  "name": "Milestones",
  "version": "0.1.0",
  "players": { "min": 2, "max": 6, "best": 4 },
  "deck": "deck.json",
  "template": "contract-rummy",
  "tagline": "Ten contracts, each harder than the last.",
  "howToPlay": [
    "Ten contracts, played in order, and you cannot skip one. Until you have laid your contract down you can do nothing but draw and discard, so the hand is a race between gathering what you need and the player who has already gone out.",
    "Wilds are worth 25 against you if you are still holding them at the end, which is what stops the answer from always being to keep them."
  ],
  "accent": "#1f7a63",
  "heroCards": [
    { "rank": "7", "color": "green" },
    { "rank": "7", "color": "blue" },
    { "rank": "wild" }
  ],
  "rules": {
    "deal": 10,
    "contracts": [
      ["set(3)", "set(3)"],
      ["set(3)", "run(4)"],
      ["set(4)", "run(4)"],
      ["run(7)"],
      ["run(8)"],
      ["run(9)"],
      ["set(4)", "set(4)"],
      ["colorGroup(7)"],
      ["set(5)", "set(2)"],
      ["set(5)", "set(3)"]
    ],
    "progression": "advance-on-complete",
    "wilds": { "tag": "wild", "minNaturals": 1, "maxPerMeld": null },
    "layDown": "once-per-round-when-complete",
    "hitting": "own-and-others-after-laydown",
    "drawFrom": ["draw", "discard"],
    "discardPickupForbidden": ["tag:skip"],
    "meldForbidden": ["tag:skip"],
    "goingOut": "play-or-discard-last"
  },
  "scoring": {
    "roundScore": "leftover-hand-values",
    "accumulate": true,
    "gameOver": { "when": "template", "winner": "template" }
  },
  "reactions": [
    { "when": "zoneEmpty:draw", "do": "recycle", "from": "discard", "keepTop": true, "shuffle": true }
  ],
  "undo": "none",
  "turnTimer": null,
  "ui": {
    "cardStyle": "sequencing",
    "cardPalette": { "red": "#c0392b", "blue": "#2f6fb0", "green": "#1f7a63", "yellow": "#d9a520" },
    "cardBack": { "pattern": "rings", "color": "#1f7a63", "emblem": "M" }
  },
  "credits": "An original contract-rummy pack: ten milestones of sets and runs, one per round, first to finish them all wins."
}
