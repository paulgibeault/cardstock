    {
      "name": "a wild takes a value the moment it is played, and the slot it filled is gone",
      "setup": {
        "seats": 3,
        "turn": {
          "seat": 0,
          "phase": "meld"
        },
        "playerVars": {
          "0": {
            "phase": 2,
            "laidDown": false
          }
        },
        "zones": {
          "hand.0": [
            "red-9",
            "blue-9",
            "green-9",
            "green-3",
            "wild",
            "wild#2",
            "blue-6",
            "red-4",
            "blue-7"
          ]
        }
      },
      "assert": [
        {
          "apply": {
            "actor": 0,
            "type": "layDown",
            "choice": {
              "melds": [
                {
                  "item": "set(3)",
                  "cards": [
                    "red-9",
                    "blue-9",
                    "green-9"
                  ]
                },
                {
                  "item": "run(4)",
                  "cards": [
                    "green-3",
                    "wild",
                    "wild#2",
                    "blue-6"
                  ]
                }
              ]
            }
          }
        },
        {
          "expect": {
            "playerVars": {
              "0": {
                "melds": [
                  {
                    "item": "set(3)",
                    "cards": [
                      "red-9",
                      "blue-9",
                      "green-9"
                    ],
                    "wilds": {}
                  },
                  {
                    "item": "run(4)",
                    "cards": [
                      "green-3",
                      "wild",
                      "wild#2",
                      "blue-6"
                    ],
                    "wilds": {
                      "wild": {
                        "rank": "4"
                      },
                      "wild#2": {
                        "rank": "5"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "move": {
            "actor": 0,
            "type": "hit",
            "cards": [
              "red-4"
            ],
            "choice": {
              "seat": 0,
              "meld": 1
            }
          },
          "legal": false,
          "rule": "invalid-meld"
        },
        {
          "move": {
            "actor": 0,
            "type": "hit",
            "cards": [
              "blue-7"
            ],
            "choice": {
              "seat": 0,
              "meld": 1
            }
          },
          "legal": true
        }
      ]
    },
    {
      "name": "a wild already on the table cannot be re-valued to make room for a card",
      "setup": {
        "seats": 3,
        "turn": {
          "seat": 0,
          "phase": "meld"
        },
        "playerVars": {
          "0": {
            "phase": 3,
            "laidDown": true
          },
          "1": {
            "phase": 2,
            "laidDown": true,
            "melds": [
              {
                "item": "run(4)",
                "cards": [
                  "green-3",
                  "wild",
                  "wild#2",
                  "blue-6"
                ],
                "wilds": {
                  "wild": {
                    "rank": "4"
                  },
                  "wild#2": {
                    "rank": "5"
                  }
                }
              }
            ]
          }
        },
        "zones": {
          "hand.0": [
            "red-4",
            "blue-2"
          ],
          "melds.1": [
            "green-3",
            "wild",
            "wild#2",
            "blue-6"
          ]
        }
      },
      "assert": [
        {
          "move": {
            "actor": 0,
            "type": "hit",
            "cards": [
              "red-4"
            ],
            "choice": {
              "seat": 1,
              "meld": 0,
              "wilds": {
                "wild": {
                  "rank": "9"
                }
              }
            }
          },
          "legal": false,
          "rule": "invalid-meld"
        },
        {
          "move": {
            "actor": 0,
            "type": "hit",
            "cards": [
              "blue-2"
            ],
            "choice": {
              "seat": 1,
              "meld": 0
            }
          },
          "legal": true
        }
      ]
    },
