    {
      "name": "a wild hit on a set takes the set's rank, so the set stays a set",
      "setup": {
        "seats": 3,
        "turn": {
          "seat": 0,
          "phase": "meld"
        },
        "playerVars": {
          "0": {
            "phase": 3,
            "laidDown": true
          },
          "1": {
            "phase": 1,
            "laidDown": true
          }
        },
        "zones": {
          "hand.0": [
            "wild",
            "red-8"
          ],
          "melds.1": [
            "red-5",
            "green-5",
            "yellow-5"
          ]
        }
      },
      "assert": [
        {
          "apply": {
            "actor": 0,
            "type": "hit",
            "cards": [
              "wild"
            ],
            "choice": {
              "seat": 1,
              "meld": 0
            }
          }
        },
        {
          "expect": {
            "playerVars": {
              "1": {
                "melds": [
                  {
                    "item": "set(4)",
                    "cards": [
                      "red-5",
                      "green-5",
                      "yellow-5",
                      "wild"
                    ],
                    "wilds": {
                      "wild": {
                        "rank": "5"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
