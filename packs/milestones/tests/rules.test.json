        },
        "zones": {
          "hand.0": [
            "red-9",
            "blue-9",
            "green-9",
            "red-11",
            "blue-12",
            "wild",
            "wild#2",
            "red-1"
          ]
        }
      },
      "assert": [
        {
          "move": {
            "actor": 0,
            "type": "layDown",
            "choice": {
              "melds": [
                {
                  "item": "set(3)",
