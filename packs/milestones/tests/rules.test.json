{
  "pack": "milestones",
  "tests": [
    {
      "name": "a valid phase-1 laydown (two sets of three, one wild used)",
      "setup": {
        "seats": 3,
        "turn": {
          "seat": 0,
          "phase": "meld"
        },
        "playerVars": {
          "0": {
            "phase": 1,
            "laidDown": false
          }
        },
        "zones": {
          "hand.0": [
            "red-3",
            "blue-3",
            "wild",
            "green-9",
            "yellow-9",
            "red-9",
            "blue-12"
          ]
        }
      },
      "assert": [
        {
          "move": {
            "actor": 0,
            "type": "layDown",
            "choice": {
              "melds": [
                {
                  "item": "set(3)",
                  "cards": [
                    "red-3",
                    "blue-3",
                    "wild"
                  ]
                },
                {
                  "item": "set(3)",
                  "cards": [
                    "green-9",
                    "yellow-9",
                    "red-9"
                  ]
                }
              ]
            }
          },
          "legal": true
        }
      ]
    },
    {
