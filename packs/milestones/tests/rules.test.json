    {
      "name": "a skip may not be picked up from the discard pile",
      "setup": {
        "seats": 3,
        "turn": {
          "seat": 0,
          "phase": "draw"
        },
        "playerVars": {
          "0": {
            "phase": 1,
            "laidDown": false
          }
        },
        "zones": {
          "discard": [
            "red-4",
            "skip"
          ],
          "hand.0": [
            "blue-5"
          ]
        }
      },
      "assert": [
        {
          "move": {
            "actor": 0,
            "type": "draw",
            "from": "discard"
          },
          "legal": false,
          "rule": "discard-pickup-forbidden"
        },
        {
          "move": {
            "actor": 0,
            "type": "draw",
            "from": "draw"
          },
          "legal": true
        }
      ]
    },
    {
      "name": "discarding a skip makes the chosen player lose their next turn",
      "setup": {
        "seats": 3,
        "turn": {
          "seat": 0,
          "phase": "discard"
        },
        "playerVars": {
          "0": {
            "phase": 1,
            "laidDown": false
          }
        },
        "zones": {
          "discard": [
            "red-4"
          ],
          "hand.0": [
            "skip",
            "red-2"
          ],
          "hand.1": [
            "blue-1"
          ],
          "hand.2": [
            "green-1"
          ]
        }
      },
      "assert": [
        {
          "apply": {
            "actor": 0,
            "type": "discard",
            "cards": [
              "skip"
            ],
            "choice": {
              "target": 1
            }
          }
        },
        {
          "expect": {
            "turn": {
              "seat": 2
            }
          }
        }
      ]
    },
    {
      "name": "round scoring counts leftover hand values against each player",
      "setup": {
        "seats": 3,
        "zones": {
          "hand.0": [],
          "hand.1": [
            "red-3",
            "wild"
          ],
          "hand.2": [
            "blue-9"
          ]
        }
      },
      "assert": [
        {
          "score": {
            "0": 0,
            "1": 30,
            "2": 5
          }
        }
      ]
    },
