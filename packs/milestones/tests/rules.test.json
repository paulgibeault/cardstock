        },
        {
          "apply": {
            "actor": 0,
            "type": "layDown",
            "choice": {
              "melds": [
                {
                  "item": "set(3)",
                  "cards": [
                    "red-9",
                    "blue-9",
                    "green-9"
                  ]
                },
                {
                  "item": "run(4)",
                  "cards": [
                    "red-11",
                    "blue-12",
                    "wild",
                    "wild#2"
                  ]
                }
              ]
            }
          }
        },
        {
          "expect": {
            "playerVars": {
              "0": {
                "melds": [
                  {
                    "item": "set(3)",
                    "cards": [
                      "red-9",
                      "blue-9",
                      "green-9"
                    ],
                    "wilds": {}
                  },
                  {
                    "item": "run(4)",
                    "cards": [
                      "red-11",
                      "blue-12",
                      "wild",
                      "wild#2"
                    ],
                    "wilds": {
                      "wild": {
                        "rank": "9"
                      },
                      "wild#2": {
                        "rank": "10"
                      }
                    }
                  }
                ]
              }
            }
          }
