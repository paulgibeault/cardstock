    {
      "name": "a wild in a run cannot be frozen to a rank the deck does not have",
      "setup": {
        "seats": 3,
        "turn": {
          "seat": 0,
          "phase": "meld"
        },
        "playerVars": {
          "0": {
            "phase": 2,
